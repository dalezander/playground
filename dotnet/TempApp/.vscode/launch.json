{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/TempAppConsole/bin/Debug/net10.0/TempAppConsole.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
            },
            "envFile": "${workspaceFolder}/.env",
            "windows": {
                "args": [
                    "platform=windows"
                ]
            },
            "linux": {
                "args": [
                    "platform=linux"
                ]
            }
        },
        {
            "name": "C#: Launch TempConsole Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/TempAppConsole/TempAppConsole.csproj",
        }
    ]
}